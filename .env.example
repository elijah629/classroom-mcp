# Public deployment origin, no trailing slash or path.
APP_ORIGIN=https://classroom-mcp.example.com

# Google Cloud Web application OAuth credentials.
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters
ALLOWED_GOOGLE_EMAILS=you@example.com
ALLOWED_CIMD_HOSTS=chatgpt.com

# Original files only. Base64 adds roughly 4/3 wire overhead; respect host response caps.
MAX_ATTACHMENT_FILES=5
MAX_ATTACHMENT_BYTES=5242880
MAX_ATTACHMENT_TOTAL_BYTES=10485760
# Example for a 4.5 MiB response cap: MAX_ATTACHMENT_TOTAL_BYTES=3145728

WORKFLOW_CONCURRENCY=4
MAX_WORKFLOW_CHARS=300000
