# Public deployment origin. No trailing slash or path.
APP_ORIGIN=https://classroom-mcp.example.com

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters

# Comma-separated Google accounts allowed to connect.
ALLOWED_GOOGLE_EMAILS=you@example.com

# Required for ChatGPT CIMD. Hostnames only; no scheme or path.
ALLOWED_CIMD_HOSTS=chatgpt.com

MAX_ATTACHMENT_TEXT_CHARS=80000
MAX_PDF_BYTES=12582912
MAX_PDF_PAGES=120
